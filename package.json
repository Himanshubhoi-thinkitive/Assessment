{
  "name": "playwright_demo",
  "version": "1.0.0",
  "description": "Playwright automation for healthcare provider workflow",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:headless": "playwright test --project=chromium --headless",
    "test:ui": "playwright test --project=chromium --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ci": "playwright test --project=chromium --headless",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "keywords": ["playwright", "automation", "testing", "healthcare"],
  "author": "Himanshubhoi-thinkitive",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.13"
  }
}